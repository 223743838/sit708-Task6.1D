<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textViewUpgradeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upgrade your experience"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp" />

        <!-- Starter Plan -->
        <Button
            android:id="@+id/buttonUpgradeStarter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Starter - Free"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#A5D6A7" />

        <!-- Intermediate Plan -->
        <Button
            android:id="@+id/buttonUpgradeIntermediate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intermediate - ₹4.99"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#64B5F6" />

        <!-- Advanced Plan -->
        <Button
            android:id="@+id/buttonUpgradeAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced - ₹9.99"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#BA68C8" />
    </LinearLayout>
</ScrollView>
