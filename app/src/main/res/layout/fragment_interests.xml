<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundDark"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Your Interests"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="24dp" android:layout_height="match_parent" android:layout_width="match_parent"/>

        <ToggleButton
            android:id="@+id/buttonAI"
            android:textOn="AI"
            android:textOff="AI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

        <ToggleButton
            android:id="@+id/buttonDataStructures"
            android:textOn="Data Structures"
            android:textOff="Data Structures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

        <ToggleButton
            android:id="@+id/buttonWebDev"
            android:textOn="Web Development"
            android:textOff="Web Development"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

        <ToggleButton
            android:id="@+id/buttonTesting"
            android:textOn="Testing"
            android:textOff="Testing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

        <ToggleButton
            android:id="@+id/buttonAlgorithms"
            android:textOn="Algorithms"
            android:textOff="Algorithms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

        <ToggleButton
            android:id="@+id/buttonCloudComputing"
            android:textOn="Cloud Computing"
            android:textOff="Cloud Computing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

        <ToggleButton
            android:id="@+id/buttonMobileApps"
            android:textOn="Mobile Apps"
            android:textOff="Mobile Apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

        <ToggleButton
            android:id="@+id/buttonMachineLearning"
            android:textOn="Machine Learning"
            android:textOff="Machine Learning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"/>

<!--        <Button-->
<!--            android:id="@+id/buttonNextInterests"-->
<!--            android:text="Next"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:backgroundTint="@color/colorAccent"-->
<!--            android:textColor="@android:color/black"-->
<!--            android:layout_marginTop="24dp"/>-->

        <Button
            android:id="@+id/buttonContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@android:color/black"
            android:layout_marginTop="24dp"/>


    </LinearLayout>
</ScrollView>
